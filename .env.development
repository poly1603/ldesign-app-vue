# 开发环境变量

# Node 环境
NODE_ENV=development

# API 基础地址（使用 JSONPlaceholder 公共 API 进行测试）
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com

# WebSocket 地址
VITE_WS_URL=ws://localhost:8080/ws

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=true

# 是否启用调试
VITE_ENABLE_DEBUG=true

# 日志级别 (debug | info | warn | error)
VITE_LOG_LEVEL=debug

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE=true

# 是否启用错误追踪
VITE_ENABLE_ERROR_TRACKING=false

# 是否启用热重载
VITE_ENABLE_HMR=true

# 开发服务器端口
VITE_DEV_SERVER_PORT=3000

# 开发服务器主机
VITE_DEV_SERVER_HOST=0.0.0.0

# 是否自动打开浏览器
VITE_OPEN_BROWSER=true

# ==================== LEAP 服务配置 ====================

# SZWSLD LEAP 服务地址（深圳志愿者信息服务平台）
# 开发环境使用本地 8084 服务（ldesign-all 项目）
VITE_SZWSLD_BASE_URL=http://localhost:8084
VITE_SZWSLD_CONTEXT=SZWSLD
VITE_SZWSLD_RPC_PATH=/LEAP/Service/RPC/RPC.DO
VITE_SZWSLD_AREA=4403

# 开发环境默认登录用户名和密码
VITE_DEFAULT_USERNAME=admin
VITE_DEFAULT_PASSWORD=admin

